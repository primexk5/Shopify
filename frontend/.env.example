# Server-only credentials. Copy this template to .env.local and fill in values there.
# Hosted site API: https://YOUR-WORLDZ-SITE/api/v1
# Direct backend API (alternative): https://YOUR-WORLDZ-BACKEND/v1
WORLDZ_API_BASE=https://YOUR-WORLDZ-SITE/api/v1
WORLDZ_CHECKOUT_ORIGIN=https://YOUR-WORLDZ-SITE
WORLDZ_API_KEY=
WORLDZ_MERCHANT_ID=
WORLDZ_PAYOUT_ACCOUNT_ID=
# Must equal WEBHOOK_SIGNING_SECRET in the Worldz BACKEND deployment.
WORLDZ_WEBHOOK_SIGNING_SECRET=
# Optional absolute path on persistent local disk. Default: .worldz-evidence
WORLDZ_EVIDENCE_DIR=
